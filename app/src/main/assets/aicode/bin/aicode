#!/bin/sh
# `aicode` command: opens the Environment Setup menu of the container environment script (provision.sh); equivalent to `provision.sh --env`.
# In production this file lives in ~/.aicode/bin/ (provision.sh one level up); the workspace draft copy (aicode-env/bin/) has the same layout,
# so locating it relative to the script's own directory works for both. All logic lives in provision.sh and its shared library lib/env-common.sh.
SELF_DIR=$(dirname "$0")
[ "${SELF_DIR#/}" = "$SELF_DIR" ] && SELF_DIR="$(pwd)/$SELF_DIR"
exec sh "$SELF_DIR/../provision.sh" --env