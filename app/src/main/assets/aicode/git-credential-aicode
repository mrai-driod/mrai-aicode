#!/bin/sh
# Custom git credential helper: a unified credential entry point for local and remote use.
#
# The credential source of truth is ~/.aicode/git-credentials; its content is an encoded string: the "store" plaintext, base64-encoded, then reversed as a whole —
# The file is not plaintext that can be echoed directly, which blocks casual cat, grep scans, and AIs reading it into context. This is obfuscation, not encryption:
# anyone who reads this script can reverse it; the point is to raise the bar, not to stop a deliberate attack.
#
# This helper decodes the file, matches by host, and outputs KV pairs. On a miss:
#   local → write cred-req-<id> via file IPC to ask the App to pop up a dialog, then poll cred-resp-<id>;
#   remote (AICODE_CRED_NO_PROMPT is non-empty; there is no App on the server) → exit empty immediately.
#
# Bound via PRoot -b: /root/.aicode inside the container and filesDir/aicode on the host are the same inode,
# so the App-side FileObserver only needs to watch filesDir/aicode for cred-req-* creation events to trigger the dialog.
# HTTPS only: git only invokes the credential helper's get for http/https remotes; SSH goes through ssh-agent and does not trigger it.
#
# The shebang uses /bin/sh: PRoot Alpine always ships busybox ash, so this must still run even if provisioning failed (no bash dependency).

op="$1"
# Only get is handled; store/erase exit empty (persisting credentials is the App-side FileCredentialRepository's job).
[ "$op" = "get" ] || exit 0

# Read all KV pairs from stdin and take the host (git credential protocol fields are already lowercased and normalized).
host=""
while IFS= read -r line; do
  case "$line" in
    host=*) host="${line#host=}" ;;
  esac
done
[ -n "$host" ] || exit 0

AICODE="${AICODE_DIR:-$HOME/.aicode}"
CREDS="$AICODE/git-credentials"

# URL decoding: %XX → bytes (pure awk, compatible with busybox awk, no extra tools needed).
urldecode() {
  printf '%s' "$1" | awk '
  {
    out = ""
    for (i = 1; i <= length($0); i++) {
      c = substr($0, i, 1)
      if (c == "%" && i + 2 <= length($0)) {
        h = substr($0, i + 1, 2)
        d1 = index("0123456789abcdef", tolower(substr(h, 1, 1))) - 1
        d2 = index("0123456789abcdef", tolower(substr(h, 2, 1))) - 1
        if (d1 >= 0 && d2 >= 0) { out = out sprintf("%c", d1 * 16 + d2); i += 2; continue }
      }
      out = out c
    }
    printf "%s", out
  }'
}

# Decode the credentials file: reverse the whole string, then base64-decode; if the base64 command is missing, fall back step by step.
decode_creds() {
  [ -f "$CREDS" ] || return 0
  raw="$(cat "$CREDS" 2>/dev/null)"
  [ -n "$raw" ] || return 0
  rev="$(printf '%s' "$raw" | awk '{ for (i = length($0); i > 0; i--) printf "%s", substr($0, i, 1) }')"
  printf '%s' "$rev" | base64 -d 2>/dev/null && return 0
  printf '%s' "$rev" | openssl base64 -d -A 2>/dev/null && return 0
  printf '%s' "$rev" | python3 -c 'import base64,sys;sys.stdout.buffer.write(base64.b64decode(sys.stdin.read()))' 2>/dev/null && return 0
  return 1
}

content="$(decode_creds)"
if [ -n "$content" ]; then
  # Match "@host" exactly at the end of the line, so gist.github.com does not falsely match github.com (awk rather than grep, in case the host contains regex metacharacters).
  line="$(printf '%s\n' "$content" | awk -v h="$host" 'substr($0, length($0) - length(h)) == "@" h { print; exit }')"
  if [ -n "$line" ]; then
    ut="${line#*://}"
    ut="${ut%@*}"
    printf 'username=%s\npassword=%s\n' "$(urldecode "${ut%%:*}")" "$(urldecode "${ut#*:}")"
    exit 0
  fi
fi

# Miss: on remote there is no App to show a dialog, so exit empty (git will naturally report an authentication failure).
[ -n "$AICODE_CRED_NO_PROMPT" ] && exit 0

# Miss (local) → write a request file (atomic write: .tmp first, then mv, which triggers inotify and prevents the App from reading a half-written file), then block while polling for the response.
RID="$(date +%s)-$$"
REQ="$AICODE/cred-req-$RID"
RESP="$AICODE/cred-resp-$RID"
printf 'host=%s\n' "$host" > "$REQ.tmp"
mv "$REQ.tmp" "$REQ"

# Poll for the response (200 ms). Hard cap ~25 min (backed by the watchdog's 30 min fallback); on timeout, give up, delete the request and exit non-zero.
i=0
while [ ! -f "$RESP" ]; do
  sleep 0.2
  i=$((i + 1))
  [ "$i" -gt 7500 ] && { rm -f "$REQ"; exit 1; }
done

# Response file content: plaintext KV username=...\npassword=... or cancel=1.
if grep -q '^cancel=1' "$RESP" 2>/dev/null; then
  rm -f "$REQ" "$RESP"
  exit 1   # User cancelled: exit non-zero so git reports an authentication failure (consistent with having no credentials).
fi

cat "$RESP"   # Feed the plaintext KV straight back to git (git handles percent-decoding itself).
rm -f "$REQ" "$RESP"
