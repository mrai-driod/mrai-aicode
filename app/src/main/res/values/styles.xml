<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AICode" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
    </style>

    <!-- Dedicated theme for the built-in browser WebView: the WebView decides which
         prefers-color-scheme to report to web pages from the android:isLightTheme of its
         host theme, while the app itself uses a fixed Light theme with Compose-controlled
         colors, so the WebView gets separate light/dark variants, selected by BrowserManager
         according to the browser's night mode. -->
    <style name="Theme.AICode.WebView" parent="Theme.AICode">
        <item name="android:isLightTheme">true</item>
    </style>

    <style name="Theme.AICode.WebView.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:isLightTheme">false</item>
    </style>

    <!-- Cold-start splash theme: uses the app icon and the app surface background color as the system window launch background, avoiding a glaring pure-white flash on cold start -->
    <style name="Theme.AICode.Splash" parent="Theme.AICode">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <color name="primary">#007ACC</color>
    <color name="splash_background_color">#F9FAFA</color>
</resources>
