<?xml version="1.0" encoding="utf-8"?>
<!-- Used when a sendFile file card is tapped to open (ACTION_VIEW + FileProvider-granted URI).
     files-path covers filesDir/projects (workspace root), filesDir/aicode (~/.aicode) and rootfs;
     cache-path covers the temp cache for SFTP downloads in remote mode and secondary copies of files that cannot be granted directly;
     external-path covers external local-directory workspaces (directories on device storage). -->
<paths>
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
    <external-path name="external" path="." />
</paths>